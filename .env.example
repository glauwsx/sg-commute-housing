# Copy this file to `.env` and fill in your own LTA DataMall API key.
# Get a free key at: https://datamall.lta.gov.sg/
#   1. Register an account / log in
#   2. Request an API Access Key (arrives by email, usually within minutes)
#   3. Paste it below
LTA_ACCOUNT_KEY=your_lta_datamall_account_key_here
